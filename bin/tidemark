#!/usr/bin/env python3
"""tidemark CLI — manual ritual for agents without a hook system.

  tidemark handoff   [--transcript PATH|--session-db PATH#SID|--agent devin]
  tidemark inject    [--cwd DIR]
  tidemark waterline [--transcript PATH|--session-db PATH|--agent devin]
  tidemark sync      [--all|--memories|--handoffs|--dirs|--tail]
  tidemark stats

With no --transcript, stdin JSON (hook-style payload) is read if piped.
Exit code is always 0 for hooks-style invocations.
"""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "tidemark"))


def _payload(argv):
    import argparse
    ap = argparse.ArgumentParser(prog="tidemark")
    ap.add_argument("--transcript", default="")
    ap.add_argument("--session-db", default="")
    ap.add_argument("--agent", default="")
    ap.add_argument("--cwd", default="")
    ap.add_argument("--session-id", default="cli")
    ap.add_argument("--trigger", default="manual")
    ap.add_argument("--source", default="startup")
    a, _ = ap.parse_known_args(argv)
    p = {"session_id": a.session_id, "cwd": a.cwd,
         "transcript_path": a.transcript, "session_db": a.session_db,
         "agent": a.agent, "trigger": a.trigger, "source": a.source}
    if not sys.stdin.isatty():
        try:
            raw = sys.stdin.read().strip()
            if raw:
                p.update(json.loads(raw))
        except (ValueError, OSError):
            pass
    return p


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd, rest = argv[0], argv[1:]
    payload = _payload(rest)

    import io
    class _Feed:  # scripts read payload from stdin — feed ours
        def __init__(self, data):
            self._s = io.StringIO(data)
        def __getattr__(self, k):
            return getattr(self._s, k)
    sys.stdin = io.StringIO(json.dumps(payload))

    if cmd == "handoff":
        import handoff
        handoff.main()
    elif cmd == "inject":
        import inject
        inject.main()
    elif cmd == "waterline":
        import waterline
        waterline.main()
    elif cmd == "sync":
        import sync as sync_mod
        sync_mod.main(rest or ["--all"])
    elif cmd == "stats":
        import store
        store._cli(["stats"])
    else:
        print("unknown command: {0}".format(cmd), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
